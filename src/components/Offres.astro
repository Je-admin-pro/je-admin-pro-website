---
import { offres, offresNote, site } from "../config.ts";
---

<section id="offres" class="bg-cream py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">

    <!-- En-tête -->
    <div class="max-w-2xl mb-14 lg:mb-20 reveal" data-reveal="up">
      <p class="text-turquoise text-xs font-sans font-semibold tracking-[0.18em] uppercase mb-4">
        Mes offres
      </p>
      <h2 class="font-display text-3xl lg:text-4xl text-marine leading-snug">
        L'offre qui correspond<br class="hidden lg:block" /> à votre situation
      </h2>
    </div>

    <!-- Cartes -->
    <div class="grid gap-6 lg:grid-cols-3 lg:items-center">
      {offres.map((offre, i) => {
        const featured = offre.recommended;
        return (
          <article
            class:list={[
              "reveal relative flex flex-col rounded-3xl px-8 py-10 text-center",
              featured
                ? "bg-cream border-2 border-turquoise shadow-2xl shadow-marine/10 lg:py-14 lg:-my-4"
                : "bg-cream-dark border border-cream-dark",
            ]}
            data-reveal="up"
            data-delay={i * 100}
          >

            {featured && (
              <span class="absolute -top-4 left-1/2 -translate-x-1/2 inline-flex items-center rounded-full bg-turquoise px-5 py-1.5 text-cream font-sans text-xs font-semibold tracking-[0.15em] uppercase whitespace-nowrap">
                Recommandée
              </span>
            )}

            <!-- Surtitre -->
            <p class="font-sans text-xs font-semibold tracking-[0.15em] uppercase text-muted-light mb-3">
              {offre.eyebrow}
            </p>

            <!-- Nom -->
            <h3 class="font-display text-2xl lg:text-3xl text-marine leading-tight">
              {offre.name}
            </h3>

            <!-- Baseline (durée / RDV) -->
            <div class="mt-4 font-sans text-sm text-anthracite space-y-0.5">
              {offre.baseline.map((line) => (
                <p>{line}</p>
              ))}
            </div>

            <div class="my-7 h-px w-full bg-marine/10" />

            <!-- Features -->
            <ul class="flex flex-col gap-4 text-left">
              {offre.features.map((f) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 shrink-0 w-5 h-5 rounded-full flex items-center justify-center bg-turquoise/10 text-turquoise">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                  </span>
                  <span class="font-sans text-sm leading-relaxed text-anthracite">
                    {f}
                  </span>
                </li>
              ))}
            </ul>

            <!-- Accroche bas de carte -->
            <div class="mt-auto pt-8">
              <div class="mb-4 h-px w-full bg-marine/10" />
              <p
                class:list={[
                  "font-sans text-xs font-semibold tracking-[0.12em] uppercase mb-2",
                  featured ? "text-turquoise" : "text-marine",
                ]}
              >
                {offre.ctaLabel}
              </p>
              <p class="font-sans text-sm italic text-muted leading-relaxed">
                {offre.ideal}
              </p>
            </div>

          </article>
        );
      })}
    </div>

    <!-- Mention tarif -->
    <p
      class="mt-12 text-center font-sans text-sm text-muted leading-relaxed reveal"
      data-reveal="up"
      data-delay={300}
    >
      {offresNote}
    </p>

    <!-- CTA -->
    <div class="mt-8 flex flex-col items-center gap-6 reveal" data-reveal="up" data-delay={400}>
      <a
        href={site.calendly}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-gradient inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-cream font-sans font-medium text-sm transition-all duration-300"
      >
        Démarrer mon accompagnement
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

  </div>
</section>
